<odoo noupdate="1">

    <record id="default_account_move_import_config" model="account.move.import.config">
        <field name="name">XLSX/XLS/ODS</field>
        <field name="sequence">100</field>
        <field name="file_format">xlsx_xls_ods</field>
        <field name="col_date">0</field>
        <field name="col_journal">1</field>
        <field name="col_account">2</field>
	<field name="col_partner">3</field>
	<!-- I can't set a value for 'col_analytic' because, if analytic is not 
	enabled, the field will be invisible and it will raise a ValidationError
	if the user assigns this column to another field -->
        <field name="col_analytic"></field>
        <field name="col_name">5</field>
        <field name="col_debit">6</field>
        <field name="col_credit">7</field>
        <field name="col_ref">8</field>
        <field name="col_reconcile_ref">9</field>
        <!-- other default values are fine, no need to change them -->
    </record>

    <record id="silae_account_move_import_config" model="account.move.import.config">
        <field name="name">SILAE</field>
        <field name="sequence">150</field>
        <field name="file_format">xlsx_xls_ods</field>
        <field name="col_journal">0</field>
        <field name="col_date">1</field>
        <field name="col_account">2</field>
        <field name="col_analytic">3</field>
        <field name="col_name">4</field>
        <field name="col_debit">5</field>
        <field name="col_credit">6</field>
    </record>

</odoo>
